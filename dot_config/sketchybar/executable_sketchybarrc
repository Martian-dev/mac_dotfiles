#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Adapted from bfpimentel's Halo palette and AeroSpace spacing.
# https://github.com/bfpimentel/dotfiles/blob/main/dotfiles/halo/ui/theme.ts
sketchybar --bar position=top height=28 margin=8 y_offset=4 \
  color=0xf2141414 corner_radius=8 blur_radius=20 \
  border_width=1 border_color=0xff414550 padding_left=8 padding_right=8 \
  topmost=window sticky=on
sketchybar --default icon.font='SF Pro:Semibold:12.0' \
  label.font='SF Pro:Regular:12.0' icon.color=0xffd6d6d6 label.color=0xffe8e8e8 \
  background.corner_radius=5 background.height=22 \
  icon.padding_left=6 icon.padding_right=6 label.padding_left=4 label.padding_right=6 \
  padding_left=2 padding_right=2
sketchybar --add event aerospace_workspace_change
for workspace in 1 2 3 4 5 6; do
  sketchybar --add item "space.$workspace" left \
    --set "space.$workspace" icon="$workspace" label.drawing=off \
    background.color=0xffd6d6d6 background.drawing=off \
    click_script="aerospace workspace $workspace" \
    script="$PLUGIN_DIR/workspace.sh $workspace" \
    --subscribe "space.$workspace" aerospace_workspace_change
 done
sketchybar --add item front_app left --set front_app icon.drawing=off \
  label.max_chars=30 script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched
sketchybar --add item clock right --set clock icon.drawing=off \
  update_freq=30 script="$PLUGIN_DIR/clock.sh" \
  click_script='open -a Calendar'
sketchybar --add item battery right --set battery icon='BAT' \
  update_freq=60 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke
sketchybar --add item volume right --set volume icon='VOL' \
  script="$PLUGIN_DIR/volume.sh" \
  click_script='open /System/Library/PreferencePanes/Sound.prefPane' \
  --subscribe volume volume_change
sketchybar --add item audio_device right --set audio_device icon.drawing=off \
  label.max_chars=20 update_freq=10 script="$PLUGIN_DIR/audio_device.sh" \
  click_script='open /System/Library/PreferencePanes/Sound.prefPane'
sketchybar --add item media right --set media icon='PLAY' \
  label.max_chars=32 script="$PLUGIN_DIR/media.sh" \
  --subscribe media media_change
sketchybar --update
